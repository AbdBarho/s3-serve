{
  "name": "s3-serve",
  "version": "2.0.0",
  "license": "MIT",
  "description": "A utility for serving files from S3",
  "author": "Abdullah Barhoum <https://github.com/AbdBarho>",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdBarho/s3-serve.git"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage"
  },
  "keywords": [
    "s3",
    "node",
    "aws",
    "express",
    "fastify",
    "nestjs"
  ],
  "prettier": {
    "printWidth": 120
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/types": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "testcontainers": "^12.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  }
}
